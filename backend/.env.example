# Backend environment variables example
# Copy to .env and fill in real values for your environment.
# DO NOT commit .env with real credentials.

# ── Security ──────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-here
DEBUG=true

# ── Database Engine ──────────────────────────────────────────────────────
# Choices: sqlite | postgresql | mariadb
# Leave unset or omit to default to postgresql.
DB_ENGINE=sqlite

# ── SQLite ───────────────────────────────────────────────────────────────
# Used when DB_ENGINE=sqlite. Default is in-memory for tests; use a file path for persistence.
# SQLITE_PATH=db.sqlite3

# ── PostgreSQL (default when DB_ENGINE is unset) ─────────────────────────
# DB_NAME=cam_db
# DB_USER=cam_user
# DB_PASSWORD=changeme
# DB_HOST=localhost
# DB_PORT=5432

# ── MariaDB (when DB_ENGINE=mariadb) ─────────────────────────────────────
# Uses PyMySQL which is installed as MySQLdb compatibility layer.
# DB_NAME=ccirp
# DB_USER=root
# DB_PASSWORD=changeme
# DB_HOST=127.0.0.1
# DB_PORT=3307
