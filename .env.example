# Django Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL for Docker)
USE_SQLITE=False
POSTGRES_DB=cam_db
POSTGRES_USER=cam_user
POSTGRES_PASSWORD=changeme-change-in-production
POSTGRES_HOST=db
POSTGRES_PORT=7000

# Alternative PostgreSQL env var names (django-environ compatible)
DB_NAME=cam_db
DB_USER=cam_user
DB_PASSWORD=changeme-change-in-production
DB_HOST=db
DB_PORT=7000

# Backend Port (host mapping for docker-compose)
BACKEND_PORT=7001

# CORS — Development: allow all origins
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS (specific origins when CORS_ALLOW_ALL_ORIGINS=False)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (optional, for development use console backend)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password