# Django Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL)
# Vars DB_* are the official Django variables.
# docker-compose.yml maps DB_NAME -> POSTGRES_DB, DB_USER -> POSTGRES_USER, etc.
DB_NAME=cam_db
DB_USER=cam_user
DB_PASSWORD=changeme-change-in-production
DB_HOST=db
# Internal PostgreSQL port inside Docker.
# DB_PORT=5432

# Public entrypoint
# Only the proxy is published to the host. DB, backend, frontend, and scraper stay internal.
PROXY_PORT=7000
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_COOKIE_SECURE=false

# Scraper SUNAT — internal Docker network URL.
SCRAPER_URL=http://scraper:8001

# Django settings module (default: production)
# For local development use: config.settings.development
DJANGO_SETTINGS_MODULE=config.settings.production

# CORS — development can allow all origins; production should use exact origins.
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:7000,http://127.0.0.1:7000

# Email (optional, for development use console backend)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-app-password

# HTTP security
# Keep False for local HTTP; use True only behind an HTTPS reverse proxy.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_BROWSER_XSS_FILTER=False
SECURE_CONTENT_TYPE_NOSNIFF=False
# Trusted CSRF origins for local proxy access.
CSRF_TRUSTED_ORIGINS=http://localhost:7000,http://127.0.0.1:7000

# Server: CCI example values only. Do not commit real credentials.
SSH_SERVER_CCI_HOST=10.10.5.177
SSH_SERVER_CCI_USER=user
SSH_SERVER_CCI_PORT=22
SSH_SERVER_CCI_PASSWORD=change-me
SSH_SERVER_CCI_DESCRIPTION="Maquina de pruebas"
SSH_SERVER_CCI_MODE=unrestricted
SSH_SERVER_CCI_PLATFORM=windows
# Do not quote a Windows path ending in backslash; it escapes the closing quote in dotenv.
SSH_SERVER_CCI_DEFAULT_DIR=C:\
