# Django Configuration
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=*

# Database Configuration (PostgreSQL)
# Vars DB_* son las oficiales para Django. El contenedor PostgreSQL usa POSTGRES_* internamente.
# docker-compose.yml mapea: DB_NAME → POSTGRES_DB, DB_USER → POSTGRES_USER, etc.
DB_NAME=cam_db
DB_USER=cam_user
DB_PASSWORD=changeme-change-in-production
DB_HOST=db
# Puerto interno de PostgreSQL (siempre5432 dentro del contenedor)
#DB_PORT=5432

# Puertos externos (host) — mapeados en docker-compose.yml
# DB_EXTERNAL_PORT: puerto exposé del contenedor PostgreSQL hacia el host (default 7000)
# BACKEND_PORT: puerto expose del backend hacia el host (default 7001)
# FRONTEND_PORT: puerto expose del frontend hacia el host (default 70020)
DB_EXTERNAL_PORT=7000
BACKEND_PORT=7001
FRONTEND_PORT=70020
FRONTEND_HOSTNAME=0.0.0.0

# Frontend API URL - used by Next.js frontend to communicate with backend
# In docker-compose, this resolves to http://backend:8000/api
# For local development outside Docker, use http://localhost:7001/api
NEXT_PUBLIC_API_URL=http://backend:8000/api

# Django settings module (default: production)
# Para desarrollo local usar: config.settings.development
DJANGO_SETTINGS_MODULE=config.settings.production

# CORS — Development: allow all origins (production debe especificar orígenes exactos)
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS (specific origins when CORS_ALLOW_ALL_ORIGINS=False)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Email (optional, for development use console backend)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ── Seguridad HTTP ───────────────────────────────────────────
# Mantener False para desarrollo local HTTP; True solo si se usa HTTPS reverse proxy.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_BROWSER_XSS_FILTER=False
SECURE_CONTENT_TYPE_NOSNIFF=False
# Orígenes CSRF confiados para desarrollo local (puerto 7001)
CSRF_TRUSTED_ORIGINS=http://localhost:7001,http://127.0.0.1:7001
