# ==============================================================================
# CAM Environment Example
# ==============================================================================
# Copy this file to `.env` and adjust values per environment.
# Docker uses this root `.env` as the single source of truth.


# ==============================================================================
# Django
# ==============================================================================
SECRET_KEY=change-me-in-production
DEBUG=False
ALLOWED_HOSTS=*
DJANGO_SETTINGS_MODULE=config.settings.production


# ==============================================================================
# PostgreSQL
# ==============================================================================
# DB_* are the official variables for Django.
# docker-compose.yml maps these into PostgreSQL container POSTGRES_* variables.
DB_NAME=cam_db
DB_USER=cam_user
DB_PASSWORD=change-me-in-production
DB_HOST=db
# Internal PostgreSQL port inside Docker network.
DB_PORT=5432


# ==============================================================================
# Docker / Public Ports
# ==============================================================================
# Only the proxy is published to the host.
PROXY_PORT=7000
SCRAPER_PORT=7004


# ==============================================================================
# Frontend
# ==============================================================================
# In Docker/proxy mode the browser must call the proxy path, not localhost:8000.
NEXT_PUBLIC_API_URL=/backend
NEXT_PUBLIC_FRONTEND_URL=http://localhost:7000
NEXT_PUBLIC_COOKIE_SECURE=false
NEXT_PUBLIC_IS_TEST_UUID=true
NEXT_PUBLIC_DEBUG_GENERIC_FORM_ERRORS=true
NEXT_PUBLIC_AUTH_STORAGE_PREFIX=cam_auth


# ==============================================================================
# Internal Services
# ==============================================================================
SCRAPER_URL=http://scraper:8001


# ==============================================================================
# CORS
# ==============================================================================
# Development can allow all origins; production should use exact allowed origins.
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173


# ==============================================================================
# Email Optional Settings
# ==============================================================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password


# ==============================================================================
# HTTP Security
# ==============================================================================
# Keep false for local HTTP. Use true only behind an HTTPS reverse proxy.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_BROWSER_XSS_FILTER=False
SECURE_CONTENT_TYPE_NOSNIFF=False
CSRF_TRUSTED_ORIGINS=http://localhost:7000,http://127.0.0.1:7000
